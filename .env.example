NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
# API_PORT is where the API listens; API_ORIGIN is where the web proxy and demo CLI call it. Keep the ports equal.
API_ORIGIN=http://127.0.0.1:4000
API_PORT=4000
DATABASE_PATH=./var/afterhours.sqlite
ARTIFACTS_DIR=./var/artifacts
SESSION_SECRET=
APP_PASSWORD=
TOKEN_ENCRYPTION_KEY=
DEMO_ENABLED=true
DEMO_CLI_TOKEN=
GENERATION_MODE=fixture
# Live mode uses Claude (Anthropic): MODEL_PROVIDER=anthropic, MODEL_NAME=<Claude model id>, ANTHROPIC_API_KEY.
# Fixture mode needs none of these.
MODEL_PROVIDER=fixture
MODEL_NAME=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_POLL_INTERVAL_SECONDS=15
NOTIFICATION_CHANNEL=outbox
WHATSAPP_USE_CASE_ELIGIBLE=false
WHATSAPP_CUSTOMER_SERVICE_WINDOW_UNTIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
TWILIO_CONTENT_SID=
# Email history and file context (all optional). Leave CONTEXT_FILES_ROOT empty to offer no local folder source.
# CONTEXT_FILES_ROOT=/absolute/path/the/app/may/read/project/folders/from
CONTEXT_FILES_ROOT=
CONTEXT_SUGGESTED_LOOKBACK_DAYS=90
# Days a revoked grant's retained copies are kept before the worker purges them (0 = next maintenance run).
CONTEXT_RETENTION_DAYS=30
# Retrieval budgets and decision thresholds (defaults in packages/data/src/context/limits.ts):
# CONTEXT_MAX_QUERIES=16  CONTEXT_MAX_MESSAGES=80  CONTEXT_MAX_FILES=8  CONTEXT_MAX_BYTES=41943040
# CONTEXT_MAX_UNITS=160   CONTEXT_MAX_MS=20000     CONTEXT_MIN_TARGET_SCORE=30  CONTEXT_MIN_MARGIN=12
NEXT_PUBLIC_APP_NAME=AfterHours
