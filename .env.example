NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
# API_PORT is where the API listens; API_ORIGIN is where the web proxy and demo CLI call it. Keep the ports equal.
API_ORIGIN=http://127.0.0.1:4000
API_PORT=4000
DATABASE_PATH=./var/afterhours.sqlite
ARTIFACTS_DIR=./var/artifacts
SESSION_SECRET=
APP_PASSWORD=
TOKEN_ENCRYPTION_KEY=
DEMO_ENABLED=true
DEMO_CLI_TOKEN=
GENERATION_MODE=fixture
# Live mode: MODEL_PROVIDER=anthropic (Claude) with ANTHROPIC_API_KEY, or MODEL_PROVIDER=openai with OPENAI_API_KEY.
# MODEL_NAME is the model id for the chosen provider. Fixture mode needs none of these.
MODEL_PROVIDER=fixture
MODEL_NAME=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_POLL_INTERVAL_SECONDS=15
NOTIFICATION_CHANNEL=outbox
WHATSAPP_USE_CASE_ELIGIBLE=false
WHATSAPP_CUSTOMER_SERVICE_WINDOW_UNTIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
TWILIO_CONTENT_SID=
NEXT_PUBLIC_APP_NAME=AfterHours
